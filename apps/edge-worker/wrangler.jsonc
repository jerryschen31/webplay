{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webplay-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "routes": [{ "pattern": "stream.webplay.io", "custom_domain": true }],
  "r2_buckets": [
    {
      "binding": "STREAM_BUCKET",
      "bucket_name": "webplay-stream"
    }
  ],
  "observability": {
    "enabled": true
  }
}
